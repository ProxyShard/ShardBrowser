{
  "name": "shardx-launcher",
  "private": true,
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build:ui-kit": "npm --prefix ui-kit ci --no-audit --no-fund && npm --prefix ui-kit run build:lib",
    "prebuild": "npm run build:ui-kit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "test:e2e": "playwright test",
    "e2e:built": "E2E_BUILT=1 playwright test --project=dev --project=compact --project=forced-colors",
    "preview:mock": "VITE_MOCK=1 vite build --outDir dist-mock && vite preview --outDir dist-mock --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . && node scripts/check-allowlist.mjs",
    "check": "tsc && npm run lint && npm run check:i18n && npm run check:errors && npm run check:classes && npm run check:kit && npm run test:scripts && npm run test:unit && npm run check:contrast && npm run check:colors",
    "check:classes": "node scripts/check-classes.mjs",
    "test:scripts": "node --test scripts/*.test.mjs ui-kit/scripts/*.test.mjs",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:colors": "node ui-kit/scripts/gen-colors.mjs --check",
    "kit:build": "npm --prefix ui-kit run build:lib && touch src/app/styles/index.css",
    "check:kit": "cd ui-kit && npx tsc -p tsconfig.app.json --noEmit && npm test",
    "check:strip": "node scripts/check-strip.mjs",
    "strip:dev": "node scripts/strip-dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "@proxyshard/shardx-ui-kit": "file:./ui-kit",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "flag-icons": "^7.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.10"
  }
}
