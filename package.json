{
  "name": "shardx-launcher",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui-kit": "npm --prefix ui-kit ci --no-audit --no-fund && npm --prefix ui-kit run build:lib",
    "prebuild": "npm run build:ui-kit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "@proxyshard/shardx-ui-kit": "file:./ui-kit",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "flag-icons": "^7.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.10"
  }
}
